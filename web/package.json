{
  "name": "urumi-host",
  "version": "0.2.0",
  "description": "Host control backend for urumi.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./transport": {
      "types": "./dist/transport/index.d.ts",
      "import": "./dist/transport/index.js"
    },
    "./transport/webserial": {
      "types": "./dist/transport/webserial.d.ts",
      "import": "./dist/transport/webserial.js"
    },
    "./transport/node": {
      "types": "./dist/transport/node.d.ts",
      "import": "./dist/transport/node.js"
    },
    "./transport/sim": {
      "types": "./dist/transport/sim.d.ts",
      "import": "./dist/transport/sim.js"
    },
    "./packets": {
      "types": "./dist/packets/index.d.ts",
      "import": "./dist/packets/index.js"
    },
    "./config": {
      "types": "./dist/config/index.d.ts",
      "import": "./dist/config/index.js"
    },
    "./toolpath": {
      "types": "./dist/toolpath/index.d.ts",
      "import": "./dist/toolpath/index.js"
    },
    "./link": {
      "types": "./dist/link/index.d.ts",
      "import": "./dist/link/index.js"
    },
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen:runtime": "vite-node scripts/runtime-fields.ts",
    "demo": "vite demo --open",
    "demo:dist": "vite demo --mode dist --open",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.12.0",
    "@types/node": "^22.0.0",
    "@xmldom/xmldom": "^0.9.0",
    "eslint": "^9.12.0",
    "globals": "^14.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.15.0",
    "vite": "^8.1.3",
    "vite-node": "6.0.0",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "@msgpack/msgpack": "^3.1.3"
  }
}
