{
  "name": "urumi-toolpath",
  "version": "0.1.0",
  "description": "SVG + machine config → .plan → schedule → wire packets, for the AVR128DB32 x RP2350 RS485 CNC motion controller. TypeScript, ESM, zero runtime dependencies.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "module": "./dist/index.js",
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "demo": "vite demo --open",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.12.0",
    "@types/node": "^22.0.0",
    "@vitest/ui": "^2.1.0",
    "@xmldom/xmldom": "^0.9.0",
    "eslint": "^9.12.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.15.0",
    "vite": "^8.1.3",
    "vitest": "^2.1.0"
  }
}
