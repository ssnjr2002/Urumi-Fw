// The machine's config for the Pico, flashed by `pio run -e pico -t uploadfs`
// (scripts/pio/config_image.py writes data/config.bin from this file).
//
// Fields marked "web only" are read by the web host alone and go when its
// homing path is removed; the Pico reads the ones beside them
// (docs/homing.md §3.2a, docs/plans/controller-homing.md).
//
// maxTravel on x and y: measured as (seek span steps / stepsPerUnit) -
// pullOffDist, seeking from the end opposite the switch, rounded down.
//
// Unmeasured, check when homing works:
//   maxTravel on z: estimate (old hardTravel − pullOffDist).
//   invertDir on y and z: derived from the old frames; jog + to confirm
//     (X right, Y away, Z up).
//   invertDir on a: unchecked; jog A+, expect counter-clockwise from above.
{
  "machine": {
    "fCpu": 150000000,
    "meshOn": false,
    "buffer": {            // jobs only; jogs start at once
      "queueTime": 1.0,    // s of queued motion before a job starts
      "idleTime": 0.5      // s with no new record before it starts anyway
    },
    "feed": { "cutFallback": 80, "travelDefault": 80, "plungeFallback": 10, "liftFeed": 10 },   // mm/s; `feed` overrides
    "positions": { "mount": { "x": 200, "y": 150 } },   // anchor, machine mm: a tool change stops here
    "zClearance": 2,       // mm above the material top for lifts and travel
    "slew": {},
    "x": {
      "node": { "id": 1, "present": true },
      "stepsPerUnit": 160,
      "maxFeed": 80,
      "maxAccel": 100,
      "maxTravel": 1175,         // (189000 / 160) - 5 = 1176.25, rounded down
      "softLimits": true,
      "invert": false,           // web only
      "invertDir": false,
      "rotary": false,
      "homing": {
        "kind": "linear",
        "hardTravel": 1200,      // web only
        "atOrigin": false,       // web only
        "pullInFeed": 2.5,       // web only
        "backoffMm": 2,          // web only
        "parkMm": 5,             // web only
        "seekPositive": true,    // switch on the right
        "seekScaler": 1.2,
        "startFeed": 2.5,
        "seekFeed": 12.5,
        "latchFeed": 0.78,
        "rampSteps": 400,
        "backoffDist": 2,
        "pullOffDist": 5
      }
    },
    "y": {
      "node": { "id": 2, "present": true },
      "stepsPerUnit": 160,
      "maxFeed": 80,
      "maxAccel": 100,
      "maxTravel": 735,          // (118929 / 160) - 5 = 738.31, rounded down
      "softLimits": true,
      "invert": true,            // web only
      "invertDir": true,         // confirmed by jogging Y+
      "rotary": false,
      "homing": {
        "kind": "linear",
        "hardTravel": 500,       // web only
        "atOrigin": false,       // web only
        "pullInFeed": 2.5,       // web only
        "backoffMm": 2,          // web only
        "parkMm": 5,             // web only
        "seekPositive": false,   // switch at the front (- end)
        "seekScaler": 1.2,
        "startFeed": 2.5,
        "seekFeed": 12.5,
        "latchFeed": 0.78,
        "rampSteps": 400,
        "backoffDist": 2,
        "pullOffDist": 5
      }
    },
    "laser": { "node": 3 }       // the anchor, (0, 0); wired to node 3 (-DNODE_HAS_LASER)
  },
  "heads": [
    {
      "accepts": ["knife", "crease"],
      "xOffset": -70,              // rough eyeball: tip − laser dot
      "yOffset": -30,
      "z": {
        "node": { "id": 3, "present": true },
        "stepsPerUnit": 1200,
        "maxFeed": 20,
        "maxAccel": 500,
        "maxTravel": 48,         // abs(-66530 / 1200) - 4 = 51.44, less 2 for the taped switch
        "softLimits": true,
        "invert": false,         // web only
        "invertDir": true,       // derived, unconfirmed
        "rotary": false,
        "homing": {
          "kind": "linear",
          "hardTravel": 40,      // web only
          "atOrigin": true,      // web only
          "pullInFeed": 0.3333,  // web only
          "backoffMm": 4,        // web only
          "parkMm": 4,           // web only
          "seekPositive": true,  // switch at the top
          "seekScaler": 1.2,
          "startFeed": 0.3333,   // 2500 us/step at 1200 steps/mm
          "seekFeed": 1.6667,    // 500 us/step
          "latchFeed": 1,
          "rampSteps": 400,
          "backoffDist": 4,
          "pullOffDist": 4,
          "parkPos": 0           // ISO: 0 at the top, range [-48, 0]
        }
      },
      "a": {
        "node": { "id": 4, "present": true },
        "stepsPerUnit": 45.9847,
        "maxFeed": 100,
        "maxAccel": 500,
        "maxTravel": 0,
        "softLimits": false,
        "invert": false,         // web only
        "invertDir": false,      // unchecked
        "rotary": true,
        "homing": {
          "kind": "rotary",
          "pullInFeed": 18.12,   // web only
          "datumDeg": 0,         // web only
          "budgetRevs": 4,
          "startFeed": 18.12,
          "sweepFeed": 54.37,
          "rampSteps": 400,
          "toleranceDeg": 2.0,
          "indexPos": -46.7      // the index's A: the holder's lock button latches at 0
        }
      }
    },
    {
      "accepts": [],               // the pen head, ["pen"] once it can move
      "xOffset": 60,
      "yOffset": 0,
      "z": {
        "node": { "id": 6, "present": false },  // head 1 cannot move
        "stepsPerUnit": 600,
        "maxFeed": 20,
        "maxAccel": 500,
        "maxTravel": 36,         // estimate
        "softLimits": false,
        "invert": false,         // web only
        "invertDir": true,       // derived, unconfirmed
        "rotary": false,
        "homing": {
          "kind": "linear",
          "hardTravel": 40,      // web only
          "atOrigin": true,      // web only
          "pullInFeed": 2.5,     // web only
          "backoffMm": 4,        // web only
          "parkMm": 4,           // web only
          "seekPositive": true,  // switch at the top
          "seekScaler": 1.2,
          "startFeed": 2.5,
          "seekFeed": 6,
          "latchFeed": 0.78,
          "rampSteps": 400,
          "backoffDist": 4,
          "pullOffDist": 4,
          "parkPos": 0
        }
      },
      "a": {
        "node": { "id": 5, "present": false },
        "stepsPerUnit": 2.8611,
        "maxFeed": 360,
        "maxAccel": 500,
        "maxTravel": 0,
        "softLimits": false,
        "invert": false,         // web only
        "invertDir": false,      // unchecked
        "rotary": true,
        "homing": {
          "kind": "rotary",
          "pullInFeed": 174.76,  // web only
          "datumDeg": 0,         // web only
          "budgetRevs": 4,
          "startFeed": 174.76,
          "sweepFeed": 291.27,
          "rampSteps": 400,
          "toleranceDeg": 2.0,
          "indexPos": 0
        }
      }
    }
  ],
  "defaultHead": 0,
  "peripherals": [
    { "id": 7, "type": 2, "present": true },
    { "id": 8, "type": 3, "present": false }   // off the bus
  ],
  "tools": {
    "knife": {
      "id": 1,
      "tangential": true,
      "aMaxDeg": 180,            // the cable: |A| from the lock
      "aOffsetDeg": 0,           // the edge's heading at A = 0 (the lock); measure on mount
      "unwind": true,
      "offsetMm": 0,
      "cornerAngleDeg": 20,
      "minRadiusMm": 0,
      "cutFeed": 40,
      "plungeFeed": 10,
      "toolOffset": { "xOffset": 0, "yOffset": 0 }
      // Passive until its node (peripheral 8) is back on the bus.
      // "power": { "node": { "id": 8, "type": 3 }, "settleS": 0.3,
      //            "dutyLimits": { "maxOnS": 30, "minOnS": 20, "dwellS": 2 } }
    },
    "pen": {
      "id": 2,
      "tangential": false,
      "unwind": false,
      "offsetMm": 0,
      "cornerAngleDeg": 20,
      "minRadiusMm": 0,
      "cutFeed": 80,
      "plungeFeed": 10,
      "toolOffset": { "xOffset": 0, "yOffset": 0 }
    }
  },
  "quality": {
    "chordTol": 0.01,
    "dvMax": 3.0,
    "vMin": 0.5,
    "dtMax": 0.05,
    "dtMin": 1e-06,
    "angleTol": 5.0,
    "gapTol": 0.01,
    "nKappa": 20,
    "junctionDeviation": 0.05,
    "dsMax": 0.5,
    "dthetaMax": 2.0
  }
}
